# Reference only: neither dotnet nor Vite automatically loads this root file.
# Phase 1 reads a Bridge-owned normalized inventory file, not a native SSM API.
INVENTORY_FILE=
CAMERA_CONFIG_FILE=
MAP_CONFIG_FILE=
INVENTORY_WRITE_KEY=
# Optional private screen-capture exchange. Disabled unless both are configured.
CAPTURE_SOURCE_DIR=
CAPTURE_READ_KEY=
ASPNETCORE_URLS=http://127.0.0.1:5080
# Reserved for future verified SSM adapters; currently unused.
SSM_HOST=
SSM_USERNAME=
SSM_PASSWORD=
# Public browser map key, restricted to registered VWorld website URLs.
# Bridge serves this through /api/map-client-settings. This root file is not automatically loaded.
VWORLD_API_KEY=
